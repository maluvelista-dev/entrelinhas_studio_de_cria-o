# MariaDB local: serviço "MySQL" do XAMPP. Nunca usar VITE_ para credenciais.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=book_studio
DB_USER=book_studio_app
DB_PASSWORD=configure-localmente
DB_MIGRATION_USER=book_studio_migrator
DB_MIGRATION_PASSWORD=configure-localmente
API_PORT=3000
STORAGE_ROOT=./storage
# .env.test separado: DB_NAME=book_studio_test e usuário dedicado.
# .env.production-test: DB_NAME=book_studio_test, porta da instância isolada,
# TEST_DB_TARGET=production e EXPECTED_DB_VERSION=11.4.
